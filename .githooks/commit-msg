#!/bin/sh
set -eu
msg_file=$1
msg=$(cat "$msg_file")
if [ "${#msg}" -lt 10 ]; then
  echo "Commit blocked: message must be at least 10 characters." >&2
  exit 1
fi
case "$msg" in
  feat:*|fix:*|docs:*|refactor:*|chore:*) exit 0 ;;
  *) echo "Commit blocked: use feat:, fix:, docs:, refactor:, or chore:." >&2; exit 1 ;;
esac
